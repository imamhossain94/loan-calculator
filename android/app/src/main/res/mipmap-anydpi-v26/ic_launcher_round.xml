<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  The launcher supplies the mask, so neither layer may have baked-in rounded
  corners: the background must be full-bleed square. The foreground glyph stays
  inside the central 66% safe zone so no mask shape can clip it.

  <monochrome> powers Android 13+ themed icons, where the system tints the
  glyph to match the user's wallpaper.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
